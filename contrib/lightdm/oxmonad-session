#!/bin/sh
# Session wrapper used by display managers (e.g. LightDM) to launch oxmonad as a
# Wayland session. See contrib/lightdm/README.md for installation.
#
# We force the TTY/DRM backend: a display manager's (X11) greeter can leak
# DISPLAY into the session environment, which would otherwise make oxmonad
# auto-detect the nested winit backend and fail to start.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=oxmonad
export OXMONAD_BACKEND=tty

exec /usr/local/bin/oxmonad
